{
  "name": "collate-monorepo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build -w @collate/core && npm run build -w @collate/web",
    "dev": "npm run dev -w @collate/web",
    "test": "npm test -w @collate/core",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "wallets": "tsx scripts/wallets.ts",
    "seed": "tsx scripts/seed.ts",
    "verify": "tsx scripts/verify.ts"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
