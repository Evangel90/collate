{
  "name": "@collate/core",
  "version": "0.1.0",
  "description": "Turn any Arkiv query into live, trust-filtered tables and charts in the browser. No indexer, no backend.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "arkiv",
    "dashboard",
    "query",
    "web3",
    "database"
  ],
  "dependencies": {
    "@arkiv-network/sdk": "0.8.1",
    "viem": "2.57.7"
  },
  "devDependencies": {
    "@types/react": "18.3.23",
    "react": "18.3.1"
  }
}
