{
  "name": "collate-core",
  "version": "0.1.0",
  "description": "Turn any Arkiv query into live, trust-filtered tables and charts in the browser. No indexer, no backend.",
  "author": "Evangel90",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Evangel90/collate.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Evangel90/collate/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/Evangel90/collate/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "arkiv",
    "arkiv-network",
    "dashboard",
    "query",
    "trust",
    "consensus",
    "live",
    "web3",
    "database"
  ],
  "dependencies": {
    "@arkiv-network/sdk": "0.8.1",
    "viem": "2.57.7"
  },
  "devDependencies": {
    "@types/react": "18.3.23",
    "react": "18.3.1"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
