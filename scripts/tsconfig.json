{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": [
      "node"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": "..",
    "paths": {
      "@collate/core": [
        "packages/core/src/index.ts"
      ]
    }
  },
  "include": [
    "./*.ts",
    "../apps/web/src/model/*.ts",
    "../apps/web/src/deployment.json"
  ]
}
